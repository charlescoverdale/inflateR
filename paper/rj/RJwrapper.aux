\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {CPI coverage by currency and decade in the bundled \href  {https://CRAN.R-project.org/package=inflateR}{{\normalfont  \fontseries  {b}\selectfont  inflateR}} data.} Blue tiles mark decades with at least one year of coverage; grey tiles mark absence. Eleven of the thirteen currencies are covered from 1960 onwards; CNY coverage begins 1986 and BRL coverage begins 1980.}}{3}{figure.caption.4}\protected@file@percent }
