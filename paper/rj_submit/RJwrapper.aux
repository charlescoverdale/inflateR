\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces CPI coverage by currency and decade in the bundled \texttt  {inflateR} data. Blue tiles mark decades with at least one year of coverage; grey tiles mark absence. Eleven of the thirteen currencies are covered from 1960 onwards; CNY coverage begins 1986 and BRL coverage begins 1980.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:coverage}{{1}{3}{CPI coverage by currency and decade in the bundled \texttt {inflateR} data. Blue tiles mark decades with at least one year of coverage; grey tiles mark absence. Eleven of the thirteen currencies are covered from 1960 onwards; CNY coverage begins 1986 and BRL coverage begins 1980}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.5}Value adjustment and inflation rates}{4}{section.2.5}\protected@file@percent }
\newlabel{value-adjustment-and-inflation-rates}{{2.5}{4}{Value adjustment and inflation rates}{section.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces CPI-based inflation multiplier to 2024 for five currencies, 1970 to 2024. Log-scale y-axis: a value of 10x means one unit of that year's currency has the same purchasing power as 10 units in 2024. The 1970s are the steepest decade for GBP, USD, AUD, and EUR; JPY is notably flatter, consistent with Japan's lower and later-stage inflation history.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:multipliers}{{2}{4}{CPI-based inflation multiplier to 2024 for five currencies, 1970 to 2024. Log-scale y-axis: a value of 10x means one unit of that year's currency has the same purchasing power as 10 units in 2024. The 1970s are the steepest decade for GBP, USD, AUD, and EUR; JPY is notably flatter, consistent with Japan's lower and later-stage inflation history}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Rolling 10-year annualised inflation rate across five currencies, 1970 to 2014 (start year). Dashed horizontal line at 2 per cent is the modern inflation-target norm. The late-1970s peak is visible for GBP, USD, AUD, and EUR; the mid-2000s trough (including near-zero inflation in some economies) is the global-disinflation period.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rolling}{{3}{5}{Rolling 10-year annualised inflation rate across five currencies, 1970 to 2014 (start year). Dashed horizontal line at 2 per cent is the modern inflation-target norm. The late-1970s peak is visible for GBP, USD, AUD, and EUR; the mid-2000s trough (including near-zero inflation in some economies) is the global-disinflation period}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.6}Comparing the two measures}{5}{section.2.6}\protected@file@percent }
\newlabel{comparing-the-two-measures}{{2.6}{5}{Comparing the two measures}{section.2.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CPI and GDP deflator multipliers for GBP, 1970 to 2024, both to the 2024 base. Log-scale y-axis. The two measures diverge most in high-inflation periods (the 1970s and early 1980s) and in energy- and import-sensitive episodes (the post-2020 spike). Using CPI for a wages question and the GDP deflator for a government-spending question is the intended match.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cpi-gdp}{{4}{5}{CPI and GDP deflator multipliers for GBP, 1970 to 2024, both to the 2024 base. Log-scale y-axis. The two measures diverge most in high-inflation periods (the 1970s and early 1980s) and in energy- and import-sensitive episodes (the post-2020 spike). Using CPI for a wages question and the GDP deflator for a government-spending question is the intended match}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Purchasing power of 1 unit of GBP, USD, and JPY relative to 1970, 1970 to 2024. Computed via \texttt  {1 / adjust\_inflation(1, 1970, ccy, to\_year = y)}. GBP and USD each lose the bulk of their 1970 purchasing power; JPY loses less, reflecting its lower average inflation over the period.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:power}{{5}{6}{Purchasing power of 1 unit of GBP, USD, and JPY relative to 1970, 1970 to 2024. Computed via \texttt {1 / adjust\_inflation(1, 1970, ccy, to\_year = y)}. GBP and USD each lose the bulk of their 1970 purchasing power; JPY loses less, reflecting its lower average inflation over the period}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2.7}A UK real-wages case study}{6}{section.2.7}\protected@file@percent }
\newlabel{a-uk-real-wages-case-study}{{2.7}{6}{A UK real-wages case study}{section.2.7}{}}
\citation{blundell2023real,giupponi2024wage}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces UK median weekly earnings, nominal and real (2024 GBP), 1980 to 2024. Data: Office for National Statistics Annual Survey of Hours and Earnings, median gross weekly pay for full-time employees. Grey dashed: nominal GBP (as published). Blue solid: real GBP, deflated by \texttt  {adjust\_inflation()} using World Bank CPI. Real median weekly earnings rose steadily from GBP 533 in 1980 to a peak of GBP 721 in 2010 (plus 35 per cent), then fell back to GBP 681 by 2024 (minus 5.6 per cent post-2010).}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:uk-wages}{{6}{7}{UK median weekly earnings, nominal and real (2024 GBP), 1980 to 2024. Data: Office for National Statistics Annual Survey of Hours and Earnings, median gross weekly pay for full-time employees. Grey dashed: nominal GBP (as published). Blue solid: real GBP, deflated by \texttt {adjust\_inflation()} using World Bank CPI. Real median weekly earnings rose steadily from GBP 533 in 1980 to a peak of GBP 721 in 2010 (plus 35 per cent), then fell back to GBP 681 by 2024 (minus 5.6 per cent post-2010)}{figure.caption.9}{}}
\@writefile{brf}{\backcite{blundell2023real}{{7}{2.7}{figure.caption.9}}}
